{
  "manifest_version": 3,
  "name": "Smart Tab Groups",
  "version": "1.0.0",
  "description": "Automatically group your browser tabs by domain and topic with smart classification",

  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Tab Groups",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
